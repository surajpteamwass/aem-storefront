{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "customer_location": {
      "type": "object",
      "properties": {
        "city": { "type": "string" },
        "coordinates": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lon": { "type": "number" }
          },
          "required": ["lat", "lon"]
        },
        "country": { "type": "string" },
        "ip": { "type": "string" },
        "is_default": { "type": "boolean" },
        "postal_code": { "type": "string" },
        "state": { "type": "string" }
      },
      "required": ["city", "coordinates", "country", "ip", "is_default", "postal_code", "state"]
    },
    "product_name": { "type": "string" },
    "sku": { "type": "string" },
    "success": { "type": "boolean" },
    "timestamp": { "type": "string" },
    "total_available": { "type": "number" },
    "warehouses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "address": {
            "type": "object",
            "properties": {
              "city": { "type": "string" },
              "postal_code": { "type": "string" },
              "state": { "type": "string" }
            },
            "required": ["city", "postal_code", "state"]
          },
          "distance_miles": { "type": "number" },
          "quantity_available": { "type": "number" },
          "warehouse_id": { "type": "string" },
          "warehouse_name": { "type": "string" }
        },
        "required": ["address", "distance_miles", "quantity_available", "warehouse_id", "warehouse_name"]
      }
    }
  },
  "required": ["customer_location", "product_name", "sku", "success", "timestamp", "total_available", "warehouses"]
}

